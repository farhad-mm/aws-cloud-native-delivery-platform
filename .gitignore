# Terraform working directory and provider cache
.terraform/

# Terraform state and backups
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Local variable files may contain environment-specific values or secrets
terraform.tfvars
*.auto.tfvars
*.auto.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Sensitive files
*.pem
*.key
.env
tfplan*
